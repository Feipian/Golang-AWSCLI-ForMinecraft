# Minecraft server properties
# Generated by PaperMC Docker container

# Server settings
server-name=PaperMC Server
motd=A PaperMC Server running in Docker
server-port=25565
query.port=25565
rcon.port=25575
rcon.password=changeme123

# Game settings
gamemode=survival
difficulty=easy
hardcore=false
pvp=true
allow-nether=true
allow-flight=false
max-players=20
online-mode=true
white-list=false

# World settings
level-name=world
level-type=minecraft\:normal
level-seed=
generate-structures=true
generator-settings={}
allow-nether=true

# Performance settings
view-distance=10
simulation-distance=10
max-tick-time=60000
max-chained-neighbor-updates=1000000

# Network settings
network-compression-threshold=256
use-native-transport=true
enable-jmx-monitoring=false

# PaperMC specific settings
# These are PaperMC optimizations
paper.playerconnection.keepalive=30
paper.log-player-ip-addresses=true
paper.use-alternative-luck-formula=true
paper.fix-climbing-bypassing-cramming-rule=true
paper.fix-entity-position-desync=true
paper.load-permissions-yml-before-plugins=true
paper.enable-trespasser-warnings=false
paper.anti-xray.enabled=true
paper.anti-xray.engine-mode=1
paper.anti-xray.hidden-blocks=copper_ore,deepslate_copper_ore,gold_ore,deepslate_gold_ore,iron_ore,deepslate_iron_ore,coal_ore,deepslate_coal_ore,lapis_ore,deepslate_lapis_ore,redstone_ore,deepslate_redstone_ore,diamond_ore,deepslate_diamond_ore,emerald_ore,deepslate_emerald_ore,nether_gold_ore,nether_quartz_ore,ancient_debris
paper.anti-xray.replace-blocks=stone,oak_planks,deepslate
